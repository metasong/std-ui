{
	"name": "@std-ui/ext",
	"version": "0.1.0",
	"description": "Optional extensions for std-ui. First extension: context (@provide / @consume).",
	"type": "module",
	"license": "MIT",
	"sideEffects": [
		"./dist/esm/element/template/custom-attributes/event.custom-attribute.js",
		"./dist/esm/element/template/custom-attributes/class-style.custom-attribute.js"
	],
	"main": "./dist/esm/index.js",
	"module": "./dist/esm/index.js",
	"types": "./dist/esm/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/esm/index.d.ts",
			"import": "./dist/esm/index.js",
			"default": "./dist/esm/index.js"
		},
		"./context": {
			"types": "./dist/esm/decorators/context/index.d.ts",
			"import": "./dist/esm/decorators/context/index.js",
			"default": "./dist/esm/decorators/context/index.js"
		},
		"./state": {
			"types": "./dist/esm/reactive/state/index.d.ts",
			"import": "./dist/esm/reactive/state/index.js",
			"default": "./dist/esm/reactive/state/index.js"
		},
		"./browser/*": "./dist/browser/*",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "npm run clean && tsc -p tsconfig.build.json && npm run build:bundle",
		"build:bundle": "vite build --config vite.bundle.config.ts",
		"prepublishOnly": "npm run build",
		"test": "vitest run --root .. --config vitest.config.ts ext",
		"typecheck": "tsc --noEmit -p ../tsconfig.json"
	},
	"peerDependencies": {
		"@std-ui/core": "^0.1.0"
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
