{
	"name": "std-ui-workspace",
	"private": true,
	"type": "module",
	"workspaces": [
		"src/core",
		"src/ext",
		"src/router"
	],
	"scripts": {
		"build": "npm run build -w @std-ui/core && npm run build -w @std-ui/ext && npm run build -w @std-ui/router",
		"demo": "vite --config demo/vite.config.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"devDependencies": {
		"esbuild": "^0.28.2",
		"jsdom": "^31.0.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
