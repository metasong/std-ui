{
	"name": "std-ui-ext",
	"version": "0.1.0",
	"description": "Optional extensions for std-ui. First extension: context (@provide / @consume).",
	"type": "module",
	"license": "MIT",
	"sideEffects": true,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./context": {
			"types": "./dist/decorators/context/index.d.ts",
			"import": "./dist/decorators/context/index.js",
			"default": "./dist/decorators/context/index.js"
		},
		"./state": {
			"types": "./dist/state/index.d.ts",
			"import": "./dist/state/index.js",
			"default": "./dist/state/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "npm run clean && tsc -p tsconfig.build.json && npm run build:bundle",
		"build:bundle": "vite build --config vite.bundle.config.ts",
		"prepublishOnly": "npm run build",
		"test": "vitest run --root .. --config vitest.config.ts std-ui-ext",
		"typecheck": "tsc --noEmit -p ../tsconfig.json"
	},
	"peerDependencies": {
		"std-ui": "^0.1.0"
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"vite": "^5.4.10",
		"vitest": "^2.1.9"
	},
	"publishConfig": {
		"access": "public"
	}
}
