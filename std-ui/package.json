{
	"name": "std-ui",
	"version": "0.1.0",
	"description": "Minimal UI on web standards: reactive signals, tagged HTML templates, and Custom Elements - no virtual DOM, no framework runtime.",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./signal": {
			"types": "./dist/signal/index.d.ts",
			"import": "./dist/signal/index.js",
			"default": "./dist/signal/index.js"
		},
		"./template": {
			"types": "./dist/template/index.d.ts",
			"import": "./dist/template/index.js",
			"default": "./dist/template/index.js"
		},
		"./decorators": {
			"types": "./dist/decorators/index.d.ts",
			"import": "./dist/decorators/index.js",
			"default": "./dist/decorators/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "npm run clean && tsc -p tsconfig.build.json && npm run build:bundle",
		"build:bundle": "vite build --config vite.bundle.config.ts",
		"prepublishOnly": "npm run build",
		"test": "vitest run --root ../.. --config vitest.config.ts std-ui",
		"typecheck": "tsc --noEmit -p ../../tsconfig.json",
		"demo": "vite --config demo/vite.config.ts"
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"vite": "^5.4.10",
		"vitest": "^2.1.9"
	},
	"publishConfig": {
		"access": "public"
	}
}
