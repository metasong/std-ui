// Standalone build config for publishing `std-ui` as its own package, separate from the
// app-wide `tsconfig.json` (which uses `moduleResolution: "bundler"` for Vite/Vitest).
// This config targets plain Node/ESM consumers: `module`/`moduleResolution: "NodeNext"`
// requires the explicit `.js` extensions already used throughout `src/`'s imports,
// and emits real `.js` + `.d.ts` files to `dist/` via `tsc` (no bundler involved).
{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"inlineSources": true,
		"strict": true,
		"noUncheckedIndexedAccess": false,
		"noImplicitOverride": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"rootDir": "./src",
		"outDir": "./dist/esm"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["**/*.test.ts", "dist", "node_modules"]
}
