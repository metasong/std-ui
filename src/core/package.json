{
	"name": "@std-ui/core",
	"version": "0.1.0",
	"description": "Minimal UI on web standards: reactive signals, tagged HTML templates, and Custom Elements - no virtual DOM, no framework runtime.",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"main": "./dist/esm/index.js",
	"module": "./dist/esm/index.js",
	"types": "./dist/esm/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/esm/index.d.ts",
			"import": "./dist/esm/index.js",
			"default": "./dist/esm/index.js"
		},
		"./signal": {
			"types": "./dist/esm/signal/index.d.ts",
			"import": "./dist/esm/signal/index.js",
			"default": "./dist/esm/signal/index.js"
		},
		"./template": {
			"types": "./dist/esm/template/index.d.ts",
			"import": "./dist/esm/template/index.js",
			"default": "./dist/esm/template/index.js"
		},
		"./decorators": {
			"types": "./dist/esm/decorators/index.d.ts",
			"import": "./dist/esm/decorators/index.js",
			"default": "./dist/esm/decorators/index.js"
		},
		"./browser/*": "./dist/browser/*",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "npm run clean && tsc -p tsconfig.build.json && npm run build:bundle && npm run build:release",
		"build:bundle": "vite build --config vite.bundle.config.ts",
		"build:release": "vite build --config vite.release.config.ts",
		"prepublishOnly": "npm run build",
		"test": "vitest run --root ../.. --config vitest.config.ts src/core/",
		"typecheck": "tsc --noEmit -p ../../tsconfig.json"
	},
	"devDependencies": {
		"terser": "^5.51.4",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
