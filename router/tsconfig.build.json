// Standalone build for publishing `@std-ui/router`; resolves `@std-ui/core` from node_modules (build core first).
{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"inlineSources": true,
		"strict": true,
		"noImplicitOverride": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"rootDir": "./src",
		"outDir": "./dist/esm"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["**/*.test.ts", "dist", "node_modules"]
}
